# 실제 값은 .env 에 넣고, .env 는 커밋하지 않는다.

# 카카오 개발자 콘솔(https://developers.kakao.com) > 내 애플리케이션 > 앱 키
KAKAO_REST_API_KEY=여기에_REST_API_키
KAKAO_JS_KEY=여기에_JavaScript_키

# VWorld(https://www.vworld.kr) > 오픈API > 인증키 발급
# VWORLD_DOMAIN 은 키 발급 시 등록한 URL 과 정확히 같아야 한다.
VWORLD_API_KEY=여기에_VWorld_인증키
VWORLD_DOMAIN=http://localhost
